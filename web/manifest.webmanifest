{
 "name": "Reelio",
 "short_name": "Reelio",
 "description": "Your videos, posted automatically to Instagram and YouTube.",
 "start_url": "app.html?src=pwa",
 "scope": ".",
 "display": "standalone",
 "background_color": "#edebe7",
 "theme_color": "#0c1a32",
 "icons": [
  {
   "src": "icon.svg",
   "sizes": "any",
   "type": "image/svg+xml",
   "purpose": "any"
  },
  {
   "src": "icon.svg",
   "sizes": "any",
   "type": "image/svg+xml",
   "purpose": "maskable"
  }
 ],
 "share_target": {
  "action": "app.html",
  "method": "GET",
  "params": {
   "title": "title",
   "text": "text",
   "url": "url"
  }
 },
 "shortcuts": [
